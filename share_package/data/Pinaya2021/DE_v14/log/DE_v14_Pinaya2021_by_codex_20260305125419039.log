import math

# helper for weighted mean and pooled SD

def weighted_mean(values, ns):
    return sum(v*n for v,n in zip(values, ns))/sum(ns)

def pooled_sd(means, sds, ns):
    # pooled SD for groups with means and sds
    # compute combined variance: sum((n-1)*sd"'^2 + n*(mean - overall_mean)''^2) / (N-1)
    N = sum(ns)
    overall_mean = weighted_mean(means, ns)
    ss = 0.0
    for mean, sd, n in zip(means, sds, ns):
        ss += (n-1)*(sd**2) + n*(mean-overall_mean)**2
    return math.sqrt(ss/(N-1))

# Data from tables
