import math
n1=27117
m1=54.36
sd1=20.31
n2=26985
m2=54.52
sd2=20.19
N=n1+n2
wm=(n1*m1+n2*m2)/N
# pooled SD for combined groups (unbiased): sqrt(((n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(m1-wm)**2 + n2*(m2-wm)**2)/(N-1))
var=((n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(m1-wm)**2 + n2*(m2-wm)**2)/(N-1)
psd=math.sqrt(var)
print(N, wm, psd)
