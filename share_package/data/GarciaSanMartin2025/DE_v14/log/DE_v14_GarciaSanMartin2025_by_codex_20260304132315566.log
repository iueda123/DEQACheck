import math
# SCZ-relatives
n1=96; mean1=43.75; sd1=15.25
# SAD-relatives
n2=64; mean2=40.00; sd2=16.20

N=n1+n2
weighted_mean=(n1*mean1+n2*mean2)/N
# pooled SD (weighted by sample sizes)
# pooled variance = ((n1-1)*sd1"'^2 + (n2-1)*sd2''^2 + n1*(mean1-weighted_mean)**2 + n2*(mean2-weighted_mean)**2) / (N-1)
# But for pooling means from groups, we can compute combined variance using sum of squares.
var = ((n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(mean1-weighted_mean)**2 + n2*(mean2-weighted_mean)**2) / (N-1)
pooled_sd = math.sqrt(var)
print(N, weighted_mean, pooled_sd)

# sex counts
f1=68; f2=43
f=f1+f2
m=N-f
print('"'female', f, 'male', m, 'female_pct', round(f/N*100,1), 'male_pct', round(m/N*100,1))
