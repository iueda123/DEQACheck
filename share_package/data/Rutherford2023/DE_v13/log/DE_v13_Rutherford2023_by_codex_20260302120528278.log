lines = [l.strip() for l in text.splitlines() if l.strip()]
# find second table header starting with '| Site'
start = None
for i,l in enumerate(lines):
    if l.startswith('| Site'):
        start = i
        break

if start is None:
    raise SystemExit('No site table found')

# collect table lines until a blank or non-table
rows = []
for l in lines[start:]:
    if not l.startswith('|'):
        break
    # skip separator line
    if set(l.replace('|','').strip()) <= set('- '):
        continue
    rows.append(l)

# first row is header
header = [h.strip() for h in rows[0].strip('|').split('|')]
# there is repeated header line as second row maybe
# build data rows starting from second row that isn't header repetition


def parse_row(row):
    parts = [p.strip() for p in row.strip('|').split('|')]
    return parts

data = []
for r in rows[1:]:
    parts = parse_row(r)
    # skip repeated header row
    if parts[0].lower() == 'site' and parts[1].lower() == 'n':
        continue
    if parts[0] == '':
        continue
    data.append(parts)

# columns: Site, N, Sex (F/M)%, Age (m, s.d), N, Sex (F/M)%, Age (m, s.d)

func_sites = []
for parts in data:
    if len(parts) < 7:
        continue
    site = parts[0]
    try:
        n = int(parts[1])
    except:
        continue
    sex = parts[2]
    age = parts[3]
    # train only
    # parse sex
    m = re.match(r'([0-9.]+)\\s*,\\s*([0-9.]+)', sex)
    if not m:
        continue
    f_pct = float(m.group(1))
    m_pct = float(m.group(2))
    m2 = re.match(r'([0-9.]+)\\s*,\\s*([0-9.]+)', age)
    if not m2:
        continue
    mean = float(m2.group(1))
    sd = float(m2.group(2))
    func_sites.append(dict(site=site, n=n, f_pct=f_pct, m_pct=m_pct, mean=mean, sd=sd))

# compute overall
N = sum(s['n'] for s in func_sites)
female_n = sum(s['n'] * s['f_pct']/100.0 for s in func_sites)
male_n = sum(s['n'] * s['m_pct']/100.0 for s in func_sites)

mean = sum(s['n'] * s['mean'] for s in func_sites)/N if N else float('nan')
# pooled sd
ss = sum((s['n']-1)*(s['sd']**2) + s['n']*(s['mean']-mean)**2 for s in func_sites)
pooled_sd = math.sqrt(ss/(N-1)) if N>1 else float('nan')

print('functional sites:', len(func_sites))
print('functional N:', N)
print('functional female_n:', female_n, 'male_n:', male_n)
print('functional female_pct:', female_n/N*100, 'male_pct:', male_n/N*100)
print('functional mean:', mean, 'pooled_sd:', pooled_sd)

