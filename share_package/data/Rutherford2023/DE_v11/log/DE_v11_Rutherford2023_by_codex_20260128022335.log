import re, math
from pathlib import Path
text=Path('study_1/elife-85082-supp1-v2.xlsx.md').read_text()
lines=[l for l in text.splitlines() if l.startswith('|')]
rows=[]
for l in lines:
    parts=[p.strip() for p in l.strip('|').split('|')]
    if not parts or parts[0] in ('Site','Train','N'): continue
    if parts[0].startswith('ABCD_') or parts[0] not in ('',):
        # expecting 7 columns: Site, N, Sex, Age, N, Sex, Age
        if len(parts)<7: continue
        site=parts[0]
        try:
            n_train=int(parts[1])
        except:
            continue
        sex_train=parts[2]
        age_train=parts[3]
        n_test=int(parts[4])
        sex_test=parts[5]
        age_test=parts[6]
        rows.append((site,n_train,sex_train,age_train,n_test,sex_test,age_test))

# parse percentages and age

def parse_sex(sex_str):
    # \"48.33, 51.67\" -> female, male percent
    m=re.split(r',\\s*', sex_str)
    if len(m)<2:
        return None
    return float(m[0]), float(m[1])

def parse_age(age_str):
    m=re.split(r',\\s*', age_str)
    if len(m)<2:
        return None
    return float(m[0]), float(m[1])

# compute train totals
train_n=0
train_sum_mean=0.0
train_sum_var=0.0
train_f=0.0
train_m=0.0
# for pooled sd: sum((n-1)*sd"'^2) + sum(n*(mean - grand)''^2)
# We'"'ll compute using two-pass: compute grand mean then pooled variance across groups

# first pass for train
train_groups=[]
test_groups=[]
for site,n_train,sex_train,age_train,n_test,sex_test,age_test in rows:
    fm=parse_sex(sex_train)
    am=parse_age(age_train)
    train_groups.append((n_train, am[0], am[1], fm[0], fm[1]))
    fm2=parse_sex(sex_test)
    am2=parse_age(age_test)
    test_groups.append((n_test, am2[0], am2[1], fm2[0], fm2[1]))

# compute weighted mean
train_total=sum(n for n,_,_,_,_ in train_groups)
test_total=sum(n for n,_,_,_,_ in test_groups)

train_mean=sum(n*mean for n,mean,_,_,_ in train_groups)/train_total

# pooled variance
train_var_num=sum((n-1)*(sd**2) + n*((mean-train_mean)**2) for n,mean,sd,_,_ in train_groups)
train_var=train_var_num/(train_total-1)
train_sd=math.sqrt(train_var)

# sex counts
train_f=sum(n*(f/100) for n,_,_,f,_ in train_groups)
train_m=sum(n*(m/100) for n,_,_,_,m in train_groups)

# overall (train+test) groups for overall mean
all_groups=train_groups+test_groups
all_total=sum(n for n,_,_,_,_ in all_groups)
all_mean=sum(n*mean for n,mean,_,_,_ in all_groups)/all_total
all_var_num=sum((n-1)*(sd**2) + n*((mean-all_mean)**2) for n,mean,sd,_,_ in all_groups)
all_var=all_var_num/(all_total-1)
all_sd=math.sqrt(all_var)
all_f=sum(n*(f/100) for n,_,_,f,_ in all_groups)
all_m=sum(n*(m/100) for n,_,_,_,m in all_groups)

print('train_total',train_total)
print('test_total',test_total)
print('all_total',all_total)
print('train_mean',train_mean,'train_sd',train_sd)
print('all_mean',all_mean,'all_sd',all_sd)
print('train_f',train_f,'train_m',train_m)
print('all_f',all_f,'all_m',all_m)

# show rounding

def pct(x,total):
    return x/total*100
print('train_f_pct',pct(train_f,train_total),'train_m_pct',pct(train_m,train_total))
print('all_f_pct',pct(all_f,all_total),'all_m_pct',pct(all_m,all_total))
