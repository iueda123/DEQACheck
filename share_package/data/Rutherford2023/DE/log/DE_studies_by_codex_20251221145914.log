import re,math
train_data=[]
test_data=[]
with open('study_1/elife-85082-supp1-v2.xlsx.md') as f:
    for line in f:
        m=re.match(r\"\\|\\s*[A-Za-z0-9_-]+\\s*\\|\\s*(\\d+)\\s*\\|["'^|]*'"\\|\\s*([0-9.]+)\\s*,\\s*([0-9.]+)\\s*\\|\\s*(\\d+)\\s*\\|["'^|]*'"\\|\\s*([0-9.]+)\\s*,\\s*([0-9.]+)\", line)
        if m:
            tr_n=int(m.group(1)); tr_mean=float(m.group(2)); tr_sd=float(m.group(3))
            te_n=int(m.group(4)); te_mean=float(m.group(5)); te_sd=float(m.group(6))
            train_data.append((tr_n,tr_mean,tr_sd))
            test_data.append((te_n,te_mean,te_sd))

def weighted_mean(data):
    total_n=sum(n for n,_,_ in data)
    return sum(n*m for n,m,_ in data)/total_n, total_n

def pooled_sd(data, overall_mean):
    total_n=sum(n for n,_,_ in data)
    num=sum((n-1)*(sd**2) + n*((mean-overall_mean)**2) for n,mean,sd in data)
    return math.sqrt(num/(total_n-1))

tr_mean,tr_total=weighted_mean(train_data)
te_mean,te_total=weighted_mean(test_data)
all_data=train_data+test_data
all_mean,total_n=weighted_mean(all_data)
tr_sd=pooled_sd(train_data,tr_mean)
te_sd=pooled_sd(test_data,te_mean)
all_sd=pooled_sd(all_data,all_mean)
print('train N',tr_total,'mean',round(tr_mean,2),'sd',round(tr_sd,2))
print('test N',te_total,'mean',round(te_mean,2),'sd',round(te_sd,2))
print('overall N',total_n,'mean',round(all_mean,2),'sd',round(all_sd,2))
