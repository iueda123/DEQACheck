/bin/bash -lc "python - <<'PY'
import re
from math import sqrt
from pathlib import Path
text = Path('study_1/41531_2025_957_MOESM2_ESM.xlsx.md').read_text()
rows = []
for line in text.splitlines():
    if 'Diesease (PD)' in line or 'Diesease (AD)' in line:
        # split by | and strip
        parts = [p.strip() for p in line.strip('|').split('|')]
        # parts: Dataset, Groups, HC No, HC Age, Patients No, Patients Age, ...
        dataset = parts[0]
        group = parts[1]
        n_male = parts[4]  # \"68 (65)\"
        age = parts[5]     # \"67 (9) [45-84]\"
        rows.append((dataset, group, n_male, age))


def parse_n_male(s):
    m = re.match(r\"(\\d+)\\s*\\((\\d+)\\)\", s)
    if not m:
        return None
    return int(m.group(1)), float(m.group(2))

def parse_age(s):
    # \"67 (9) [45-84]\"
    m = re.match(r\"(\\d+(?:\\.\\d+)?)\\s*\\((\\d+(?:\\.\\d+)?)\\)\\s*\\[(\\d+(?:\\.\\d+)?)-(\\d+(?:\\.\\d+)?)\\]\", s)
    if not m:
        return None
    return float(m.group(1)), float(m.group(2)), float(m.group(3)), float(m.group(4))

from collections import defaultdict

groups = defaultdict(list)
for dataset, group, n_male, age in rows:
    n, male_pct = parse_n_male(n_male)
    med, sd, amin, amax = parse_age(age)
    label = 'PD' if 'PD' in group else 'AD'
    groups[label].append({
        'dataset': dataset,
        'n': n,
        'male_pct': male_pct,
        'median': med,
        'sd': sd,
        'min': amin,
        'max': amax,
    })

for label, items in groups.items():
    total_n = sum(i['n'] for i in items)
    # weighted mean using median as proxy
    wmean = sum(i['n']*i['median'] for i in items) / total_n
    # pooled SD assuming means = medians
    # pooled variance = sum((n-1)*sd"'^2 + n*(mean-mean_total)''^2) / (N-1)
    mean_total = wmean
    num = 0.0
    for i in items:
        num += (i['"'n']-1)*(i['sd']**2) + i['n']*((i['median']-mean_total)**2)
    pooled_sd = sqrt(num/(total_n-1))
    min_age = min(i['min'] for i in items)
    max_age = max(i['max'] for i in items)
    print(label, total_n, wmean, pooled_sd, min_age, max_age)
