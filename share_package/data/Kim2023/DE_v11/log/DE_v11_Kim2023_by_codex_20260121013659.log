import math
n1=27117; m1=54.36; sd1=20.31
n2=26985; m2=54.52; sd2=20.19
mean=(n1*m1+n2*m2)/(n1+n2)
# pooled sd for combined groups
# use standard formula for pooled variance from groups
var=((n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(m1-mean)**2 + n2*(m2-mean)**2)/(n1+n2-1)
sd=math.sqrt(var)
print(mean, sd)
