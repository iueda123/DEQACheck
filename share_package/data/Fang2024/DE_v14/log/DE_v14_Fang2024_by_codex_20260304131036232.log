# we'"'ll compute combined male pct
male_total=sum(male_n_exact)
female_total=N-male_total
male_pct_total=male_total/N*100
female_pct_total=female_total/N*100
print(male_total,female_total,male_pct_total,female_pct_total)
# BD male/female
