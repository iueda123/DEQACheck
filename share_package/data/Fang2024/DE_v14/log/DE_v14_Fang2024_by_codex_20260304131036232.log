import math
# SCZ combine CNP (n=37, mean=35.54, sd=9.08) and COBRE (n=61, mean=36.57, sd=12.97)
ns=[37,61]
means=[35.54,36.57]
sds=[9.08,12.97]
N=sum(ns)
weighted_mean=sum(n*m for n,m in zip(ns,means))/N
# pooled SD (assuming sample SD); formula sqrt(((n1-1)s1"'^2+(n2-1)s2''^2 + n1*(m1-mean)''^2 + n2*(m2-mean)''^2)/(N-1))? Actually pooled for combined data using means.
# Use combined variance: (sum((n-1)*sd''^2) + sum(n*(mean - overall)''^2)) / (N-1)
var=sum((n-1)*(sd**2) for n,sd in zip(ns,sds)) + sum(n*(m-weighted_mean)**2 for n,m in zip(ns,means))
var/=(N-1)
pooled_sd=math.sqrt(var)
print(N, weighted_mean, pooled_sd)
# sex counts
male_pct=[57.50,78.69]
male_n=[round(n*p/100) for n,p in zip(ns,male_pct)]
