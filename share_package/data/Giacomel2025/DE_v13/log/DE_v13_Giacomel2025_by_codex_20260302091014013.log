import math
n1=54; mean1=26.52; sd1=7.87
n2=23; mean2=24.39; sd2=4.90
N=n1+n2
weighted=(n1*mean1+n2*mean2)/N
# pooled sd (sample)
var=((n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(mean1-weighted)**2 + n2*(mean2-weighted)**2)/(N-1)
pooled=math.sqrt(var)
print(N, weighted, pooled)
