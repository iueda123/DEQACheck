# pooled SD: sqrt( sum((n-1)*sd"'^2 + n*(m-mean)''^2)/ (N-1) )
ss = 0.0
for n,m,sd,_,_ in sites:
    ss += (n-1)*sd**2 + n*(m-mean)**2
pooled_sd = math.sqrt(ss/(N-1))
female = sum(f for _,_,_,f,_ in sites)
male = sum(m for _,_,_,_,m in sites)
print('"'N',N)
print('mean',mean)
print('pooled sd',pooled_sd)
print('female',female,'male',male)
print('female pct',female/N*100,'male pct',male/N*100)
