import re
from pathlib import Path
import math

path = Path('study_1/elife-72904-supp1-v2.docx.md')
text = path.read_text()
lines = [l for l in text.splitlines() if l.strip().startswith('|')]
# parse markdown table
rows = []
for line in lines:
    parts = [p.strip() for p in line.strip().strip('|').split('|')]
    if parts[0] == 'Site' or parts[0] == '' or parts[0].startswith('---'):
        continue
    if parts[0] == '':
        continue
    # Expect 10 columns: Site, Train N, Train Sex, Train Age, Control Test N, Control Test Sex, Control Test Age, Patient Test N, Patient Sex, Patient Age
    if len(parts) < 10:
        continue
    rows.append(parts[:10])

# helper parse N

def parse_num(val):
    val = val.strip()
    if not val:
        return None
    # remove commas
    val = val.replace(',', '')
    # handle non-numeric
    if not re.search(r'\\d', val):
        return None
    # extract first number (int or float)
    m = re.search(r'-?\\d+(?:\\.\\d+)?', val)
    if not m:
        return None
    try:
        if '.' in m.group(0):
            return float(m.group(0))
        return int(m.group(0))
    except ValueError:
        return None

# parse age \"mean, sd\"

def parse_age(val):
    val = val.strip()
    if not val:
        return (None, None)
    # split by comma
    parts = [p.strip() for p in val.split(',')]
    if len(parts) >= 2:
        mean = parse_num(parts[0])
        sd = parse_num(parts[1])
        return (mean, sd)
    return (parse_num(val), None)

# compute totals

def add_stats(stats, n, mean, sd):
    if n is None or mean is None or sd is None:
        return
    stats.append((n, mean, sd))

train_stats = []
control_test_stats = []
train_n_total = 0
control_test_n_total = 0

for site, train_n, train_sex, train_age, ctl_n, ctl_sex, ctl_age, pat_n, pat_sex, pat_age in rows:
    n_train = parse_num(train_n)
    n_ctl = parse_num(ctl_n)
    if isinstance(n_train, float):
        n_train = int(n_train)
    if isinstance(n_ctl, float):
        n_ctl = int(n_ctl)
    if n_train:
        train_n_total += n_train
    if n_ctl:
        control_test_n_total += n_ctl
    m, sd = parse_age(train_age)
    add_stats(train_stats, n_train, m, sd)
    m2, sd2 = parse_age(ctl_age)
    add_stats(control_test_stats, n_ctl, m2, sd2)

# compute weighted mean and pooled SD

def weighted_mean(stats):
    num = sum(n*mean for n, mean, sd in stats)
    den = sum(n for n, mean, sd in stats)
    return num/den if den else None

def pooled_sd(stats, overall_mean):
    # combined sd across groups
    total_n = sum(n for n, mean, sd in stats)
    if not total_n or total_n <= 1:
        return None
    sum_sq = 0.0
    for n, mean, sd in stats:
        sum_sq += (n-1)*(sd**2) + n*((mean - overall_mean)**2)
    return math.sqrt(sum_sq / (total_n - 1))

train_mean = weighted_mean(train_stats)
train_sd = pooled_sd(train_stats, train_mean)
all_stats = train_stats + control_test_stats
all_mean = weighted_mean(all_stats)
all_sd = pooled_sd(all_stats, all_mean)

print('train_n_total', train_n_total)
print('control_test_n_total', control_test_n_total)
print('overall_total', train_n_total + control_test_n_total)
print('train_mean', train_mean, 'train_sd', train_sd)
print('overall_mean', all_mean, 'overall_sd', all_sd)
