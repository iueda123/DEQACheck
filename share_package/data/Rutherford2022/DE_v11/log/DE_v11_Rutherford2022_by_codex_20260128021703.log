    control_f += f2
    control_m += m2

print('train totals', train_f, train_m)
print('control totals', control_f, control_m)
print('overall totals', train_f+control_f, train_m+control_m, train_f+train_m+control_f+control_m)
print('overall female pct', (train_f+control_f)/(train_f+train_m+control_f+control_m)*100)
