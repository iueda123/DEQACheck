import math
# define data as list of (N, mean, sd)
# ADHD
adhd=[(22,10.22,1.56),(52,10.05,1.67)]
# ASD
asd=[(47,10.94,1.53),(77,10.23,1.50),(127,12.83,6.86),(74,21.61,7.78)]
# EP
ep=[(23,22.39,4.26),(59,22.97,3.84),(31,23.56,3.46),(10,20.32,2.99)]
# SZ
sz=[(70,32.77,9.77),(531,32.42,10.45)]
# BD
bd=[(63,35.33,9.75),(59,34.63,9.35),(69,45.07,12.62),(47,37.89,9.79),(61,41.70,11.18),(16,40.50,11.48),(57,43.33,12.18),(111,45.23,13.18),(104,31.44,11.86),(134,33.62,8.73)]
# MDD
mdd=[(70,32.77,9.77),(111,45.23,13.18),(104,31.44,11.86)]

def pooled_stats(data):
    N=sum(n for n,_,_ in data)
    mean=sum(n*m for n,m,_ in data)/N
    # pooled variance: sum((n-1)*sd"'^2 + n*(m-mean)''^2) / (N-1)
    ssw=sum((n-1)*(sd**2) + n*((m-mean)**2) for n,m,sd in data)
    var=ssw/(N-1) if N>1 else 0
    return N, mean, math.sqrt(var)

for name, data in [('"'ADHD',adhd),('ASD',asd),('EP',ep),('SZ',sz),('BD',bd),('MDD',mdd)]:
    N, mean, sd = pooled_stats(data)
    print(name, N, mean, sd)
