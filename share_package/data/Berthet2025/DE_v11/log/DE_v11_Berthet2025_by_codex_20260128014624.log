N=sum(n)
wm=sum(ni*mi for ni,mi in zip(n,mean))/N
print('weighted mean',wm)
# pooled SD
sd=[10.3,7.7,11.1]
# pooled variance = sum((n_i-1)*sd_i"'^2 + n_i*(mean_i - wm)''^2)/(N-1)
var=sum((ni-1)*(s**2)+ni*(m-wm)**2 for ni,s,m in zip(n,sd,mean))/(N-1)
print('"'pooled sd',math.sqrt(var))
