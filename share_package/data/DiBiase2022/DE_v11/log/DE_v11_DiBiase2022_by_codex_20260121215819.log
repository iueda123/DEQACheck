import math
n1=62; mean1=24.30; sd1=4.10
n2=1065; mean2=28.75; sd2=3.67
N=n1+n2
wmean=(n1*mean1+n2*mean2)/N
# pooled sd (overall) using standard formula with means
# compute sum of squares
ss = (n1-1)*sd1**2 + (n2-1)*sd2**2 + n1*(mean1-wmean)**2 + n2*(mean2-wmean)**2
# sample variance
var = ss/(N-1)
psd=math.sqrt(var)
print(N,wmean,psd)
