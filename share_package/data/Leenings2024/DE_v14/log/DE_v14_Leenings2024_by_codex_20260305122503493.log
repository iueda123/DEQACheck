/bin/bash -lc "python - <<'PY'
import math

def weighted_mean(ns, means):
    return sum(n*m for n,m in zip(ns,means))/sum(ns)

def pooled_sd(ns, sds, means):
    # pooled sample SD for combined groups
    N=sum(ns)
    mean=weighted_mean(ns,means)
    # sum of squares within + between
    ss_within=sum((n-1)*(sd**2) for n,sd in zip(ns,sds))
    ss_between=sum(n*(m-mean)**2 for n,m in zip(ns,means))
    # total sample variance
    var=(ss_within+ss_between)/(N-1)
    return math.sqrt(var)

# MCI
ns=[1529,78,63]
means=[66.71,68.05,66.67]
sds=[4.25,3.54,4.85]
mean=weighted_mean(ns,means)
psd=pooled_sd(ns,sds,means)
print('MCI mean',mean,'sd',psd,'N',sum(ns))
# AD
ns=[588,28,228]
means=[67.2,66.89,66.54]
sds=[4.65,4.44,4.94]
mean=weighted_mean(ns,means)
psd=pooled_sd(ns,sds,means)
print('AD mean',mean,'sd',psd,'N',sum(ns))
# female pct
for label, N, f in [('MCI',1670,799),('AD',844,404),('FTD',317,120)]:
    print(label, f/N*100, (N-f)/N*100)
