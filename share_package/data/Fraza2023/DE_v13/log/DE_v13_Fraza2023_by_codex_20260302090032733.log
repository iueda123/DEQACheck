    female_counts.append((name,N,f_n,m_n))

print(female_counts)
print('Total N', sum(N for _,N,_,_ in female_counts))
print('Female total', sum(f for _,_,f,_ in female_counts))
print('Male total', sum(m for _,_,_,m in female_counts))
# overall percentages
N_total=sum(N for _,N,_,_ in female_counts)
F_total=sum(f for _,_,f,_ in female_counts)
M_total=sum(m for _,_,_,m in female_counts)
print('Overall female pct', F_total/N_total*100)
print('Overall male pct', M_total/N_total*100)

# weighted mean and pooled SD
# means and sds
rows_age=[
    ('Cam-CAN',656,54.93,18.60),
    ('HCP',1112,28.80,3.70),
    ('OASIS 3',2144,70.60,9.52),
    ('PNC',1296,14.37,3.45),
    ('UKB',14412,62.50,7.48),
]
N_total=sum(r[1] for r in rows_age)
weighted_mean=sum(N*mean for _,N,mean,sd in rows_age)/N_total
# pooled SD using sum of squares formula
# pooled variance = (sum((n-1)*sd"'^2) + sum(n*(mean - weighted_mean)''^2)) / (N_total-1)
ss_within=sum((N-1)*(sd**2) for _,N,mean,sd in rows_age)
ss_between=sum(N*((mean-weighted_mean)**2) for _,N,mean,sd in rows_age)
pooled_var=(ss_within+ss_between)/(N_total-1)
pooled_sd=math.sqrt(pooled_var)
print('"'weighted mean', weighted_mean)
print('pooled sd', pooled_sd)
