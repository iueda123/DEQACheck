]
N = sum(n for n,_,_ in data)
wm = sum(n*mean for n,mean,_ in data)/N
# pooled SD with between-group component
ss = 0.0
for n,mean,sd in data:
    ss += (n-1)*(sd**2) + n*((mean-wm)**2)
psd = math.sqrt(ss/(N-1))
print(N, wm, psd)
