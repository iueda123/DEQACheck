import math
# data from Table S1
cohorts = {
    'HCP-D': {'train': {'n':521,'mean':14.41,'sd':4.06}, 'test': {'n':131,'mean':14.53,'sd':4.07}},
    'HCP-YA': {'train': {'n':877,'mean':28.79,'sd':3.69}, 'test': {'n':219,'mean':28.78,'sd':3.70}},
    'HCP-A': {'train': {'n':580,'mean':60.29,'sd':15.70}, 'test': {'n':145,'mean':60.61,'sd':15.89}},
}

def weighted_mean(groups):
    total_n=sum(g['n'] for g in groups)
    return sum(g['n']*g['mean'] for g in groups)/total_n

def pooled_sd(groups):
    # pooled sample sd across groups
    total_n=sum(g['n'] for g in groups)
    # use sum of squares
    grand_mean = weighted_mean(groups)
    ss = 0.0
    for g in groups:
        n, m, sd = g['n'], g['mean'], g['sd']
        ss += (n-1)*(sd**2) + n*(m-grand_mean)**2
    return math.sqrt(ss/(total_n-1))

train_groups=[cohorts[c]['train'] for c in cohorts]
all_groups=[cohorts[c]['train'] for c in cohorts]+[cohorts[c]['test'] for c in cohorts]

print('train N',sum(g['n'] for g in train_groups))
print('overall N',sum(g['n'] for g in all_groups))
print('train mean',weighted_mean(train_groups))
print('train sd pooled',pooled_sd(train_groups))
print('overall mean',weighted_mean(all_groups))
print('overall sd pooled',pooled_sd(all_groups))
