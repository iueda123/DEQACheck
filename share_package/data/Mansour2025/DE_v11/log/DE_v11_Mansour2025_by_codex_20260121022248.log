# compute female/male counts from percentages
cohorts = {
    'HCP-D': {'train': {'n':521,'female_pct':53.7}, 'test': {'n':131,'female_pct':54.2}},
    'HCP-YA': {'train': {'n':877,'female_pct':54.4}, 'test': {'n':219,'female_pct':54.3}},
    'HCP-A': {'train': {'n':580,'female_pct':55.9}, 'test': {'n':145,'female_pct':56.6}},
}

def counts(groups):
    total_n=sum(g['n'] for g in groups)
    female=sum(g['n']*g['female_pct']/100 for g in groups)
    # rounding? We'll keep to nearest whole number
    female_round=round(female)
    male_round=total_n - female_round
    return total_n, female, female_round, male_round

train_groups=[cohorts[c]['train'] for c in cohorts]
all_groups=[cohorts[c]['train'] for c in cohorts]+[cohorts[c]['test'] for c in cohorts]

for label, groups in [('train',train_groups),('overall',all_groups)]:
    total_n, female, female_round, male_round = counts(groups)
    print(label, 'total', total_n, 'female', female, 'female_round', female_round, 'male_round', male_round, 'female_pct', female_round/total_n*100)
