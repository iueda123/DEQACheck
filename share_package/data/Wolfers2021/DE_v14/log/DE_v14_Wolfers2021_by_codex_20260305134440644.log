import math
# data: (N, male_pct, mean, sd)
scz = [
    (105, 64.76, 27.0, 8.8),
    (94, 57.44, 28.0, 9.2),
    (163, 64.40, 31.0, 8.7),
]
bp = [
    (61, 45.90, 31.0, 11.8),
    (116, 35.34, 31.0, 10.8),
    (190, 41.80, 34.0, 11.3),
]

def weighted_mean(data):
    N = sum(n for n,_,_,_ in data)
    return sum(n*m for n,_,m,_ in data)/N

def pooled_sd(data):
    # pooled sd with means
    N = sum(n for n,_,_,_ in data)
    mean = weighted_mean(data)
    # compute pooled variance across groups
    # formula: sum((n-1)*sd"'^2 + n*(mean_i-mean)''^2) / (N-1)
    num = 0.0
    for n,_,m,sd in data:
        num += (n-1)*(sd**2) + n*((m-mean)**2)
    var = num/(N-1)
    return math.sqrt(var)

def sex_counts(data):
    total_n = sum(n for n,_,_,_ in data)
    male_n = sum(n*male_pct/100.0 for n,male_pct,_,_ in data)
    # round to nearest whole
    male_n_round = int(round(male_n))
    female_n = total_n - male_n_round
    male_pct_total = male_n_round/total_n*100
    female_pct_total = female_n/total_n*100
    return total_n, male_n, male_n_round, female_n, male_pct_total, female_pct_total

for label,data in [('"'SCZ',scz),('BP',bp)]:
    N=sum(n for n,_,_,_ in data)
    print(label,'N',N,'mean',weighted_mean(data),'sd',pooled_sd(data))
    print('sex',sex_counts(data))

