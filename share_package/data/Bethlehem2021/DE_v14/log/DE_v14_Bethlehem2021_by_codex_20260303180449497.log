    'DEMENTIA - LBD': ('Neurocognitive disorders','DLB'),
    'PD': ('Neurocognitive disorders','PD'),
    'MCI': ('Neurocognitive disorders','MCI'),
    'EMCI': ('Alzheimer spectrum','EMCI'),
    'LMCI': ('Alzheimer spectrum','LMCI'),
    'ADHD': ('Neurodevelopmental disorders','ADHD'),
    'ASD': ('Neurodevelopmental disorders','ASD'),
    'Anxiety/Phobia': ('Anxiety disorders','ANX'),
    'SPECIFIC PHOBIA': ('Anxiety disorders','Specific'),
    'OCD': ('Anxiety disorders','OCD'),
    'SAD': ('Anxiety disorders','Social'),
    'BD': ('Mood disorders','BD'),
    'MDD': ('Mood disorders','MDD'),
    'SCZ': ('Psychotic disorders','SCZ'),
    'Schizoaffective Disorder': ('Psychotic disorders','SZA'),
}

f='study_1/Table3_CaseControl/Table_3_22_t50_Grey_matter_volume_PermDx.csv'
rows=defaultdict(list)
with open(f, newline='') as fh:
    r=csv.DictReader(fh)
    header = ','.join(r.fieldnames)
    for row in r:
        d=row['Group 2']
        if d not in map_disorders:
            continue
        rows[d].append(row)

clinical_cohorts=[]
for disorder,(maj,minor) in map_disorders.items():
    if disorder not in rows:
        continue
    # pick rows where Group 1 == CN if available
    candidates=[row for row in rows[disorder] if row['Group 1']=='CN']
    if not candidates:
        candidates=rows[disorder]
    female=next((r for r in candidates if r['Sex']=='Female'), None)
    male=next((r for r in candidates if r['Sex']=='Male'), None)
    # fallback to any row by sex if CN not present
    if female is None:
        female=next((r for r in rows[disorder] if r['Sex']=='Female'), None)
    if male is None:
        male=next((r for r in rows[disorder] if r['Sex']=='Male'), None)

    fn=int(female['Sample size G2']) if female else None
    mn=int(male['Sample size G2']) if male else None
    total=fn+mn if fn is not None and mn is not None else None
    male_pct=round(mn/total*100,1) if total else None
    female_pct=round(fn/total*100,1) if total else None

    supporting_lines=[]
    if female:
        supporting_lines.append(','.join([female[k] for k in female]))
    if male:
        supporting_lines.append(','.join([male[k] for k in male]))
    supporting_text='\\n'.join(f'\"{line}\"' for line in supporting_lines)

    cohort={
        \"cc1_disorder_category\": {
            \"disorder_major\": maj,
            \"disorder_minor\": minor,
        },
        \"cc2_datasets\": {
            \"answer\": [
                {\"name\": \"MULTI-DATASET (UNSPECIFIED OR N>=10)\", \"label\": \"Non-EPD\"}
            ],
            \"detail\": \"Clinical cases aggregated across multiple primary studies\",
            \"confidence_rating\": \"Medium\",
            \"supporting_text\": \"\\\"we aggregated 123,984 MRI scans, across more than 100 primary studies, from 101,457 human participants\\\"\",
            \"location\": \"Bethlehem2021.pdf.md: Introduction\"
        },
        \"cc3_n\": {
            \"answer\": total,
            \"detail\": \"Total clinical cohort N (Female + Male) from case-control centile comparisons (t50 GMV)\",
            \"confidence_rating\": \"High\",
            \"supporting_text\": supporting_text,
            \"location\": \"Table_3_22_t50_Grey_matter_volume_PermDx.csv: rows for {0} (Female/Male, Group 1 = CN when available)\".format(disorder)
        },
        \"cc4_sex\": {
            \"answer\": {
                \"male_n\": mn,
                \"male_pct\": male_pct,
                \"female_n\": fn,
                \"female_pct\": female_pct
            },
            \"detail\": \"Sex-specific sample sizes from case-control centile comparisons (t50 GMV); percentages calculated from counts\",
            \"confidence_rating\": \"High\",
            \"supporting_text\": supporting_text,
            \"location\": \"Table_3_22_t50_Grey_matter_volume_PermDx.csv: rows for {0} (Female/Male, Group 1 = CN when available)\".format(disorder)
        },
        \"cc5_age\": {
            \"answer\": \"NR\",
            \"detail\": \"Age not reported for clinical cohorts in case-control centile comparison table\",
            \"confidence_rating\": \"Low\",
            \"supporting_text\": f\"\\\"{header}\\\"\",
            \"location\": \"Table_3_22_t50_Grey_matter_volume_PermDx.csv: header\"
        }
    }
    clinical_cohorts.append(cohort)

out={
    \"paper_id\": paper_id,
    \"clinical_cohort_applicability\": \"Yes\",
    \"clinical_cohorts\": clinical_cohorts
}

with open('DE_v14_Bethlehem2021_by_codex_20260303180449497.json','w') as f:
    json.dump(out,f,ensure_ascii=True,indent=2)
