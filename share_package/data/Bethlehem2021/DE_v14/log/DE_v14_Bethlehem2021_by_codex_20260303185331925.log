import pandas as pd, json, math
from pathlib import Path

# Load table
p=Path('study_1/Table3_CaseControl/Table_3_1_Grey_matter_volume_PermDx.csv')
df=pd.read_csv(p)
cn_df=df[df['Group 1']=='CN']

# mapping
mapping={
    'AD': ('AD', 'Neurocognitive disorders'),
    'ADHD': ('ADHD', 'Neurodevelopmental disorders'),
    'ASD': ('ASD', 'Neurodevelopmental disorders'),
    'Anxiety/Phobia': ('ANX', 'Anxiety disorders'),
    'LMCI': ('LMCI', 'Alzheimer spectrum'),
    'MCI': ('MCI', 'Neurocognitive disorders'),
    'MDD': ('MDD', 'Mood disorders'),
    'SCZ': ('SCZ', 'Psychotic disorders'),
}

# supporting text for dataset
dataset_supporting_text=(
    \"we aggregated 123,984 MRI scans, across more than 100 primary studies, from 101,457 human participants\"
)

dataset_location=\"Bethlehem2021.pdf.md: Introduction\"

# function to compute

def pct(x, total):
    if total==0:
        return 0.0
    return round(x*100/total, 1)

# row lines for supporting text
import csv, io

def row_to_csv(row):
    output=io.StringIO()
    writer=csv.writer(output)
    writer.writerow(row.tolist())
    return output.getvalue().strip('\\r\\n')

cohorts=[]

for dx, (minor, major) in mapping.items():
    sub=cn_df[cn_df['Group 2']==dx]
    # ensure have female and male rows
    # use Sample size G2
    female_row=sub[sub['Sex']=='Female'].iloc[0]
    male_row=sub[sub['Sex']=='Male'].iloc[0]
    female_n=int(female_row['Sample size G2'])
    male_n=int(male_row['Sample size G2'])
    total_n=female_n+male_n
    female_pct=pct(female_n,total_n)
    male_pct=pct(male_n,total_n)
    n_detail=\"Total N computed as Female+Male Sample size G2 from Table_3_1 (CN vs diagnosis).\"
    sex_detail=\"Male/Female counts from Sample size G2 by sex; percentages computed from total N.\"
    n_support=f\"{row_to_csv(female_row)} | {row_to_csv(male_row)}\"
    location=str(p.name)

    cohort={
        \"minor_category\": minor,
        \"major_category\": major,
        \"dataset_of_origin\": [
            {
                \"answer\": {
                    \"name\": \"MULTI-DATASET (UNSPECIFIED OR N>=10)\",
                    \"label\": \"Unknown\"
                },
                \"detail\": \"Aggregated across many primary studies; specific datasets per diagnosis not reported.\",
                \"confidence_rating\": \"Low\",
                \"supporting_text\": dataset_supporting_text,
                \"location\": dataset_location
            }
        ],
        \"n\": {
            \"answer\": str(total_n),
            \"detail\": n_detail,
            \"confidence_rating\": \"Medium\",
            \"supporting_text\": n_support,
            \"location\": location
        },
        \"sex\": {
            \"answer\": {
                \"male_n\": male_n,
                \"male_pct\": male_pct,
                \"female_n\": female_n,
                \"female_pct\": female_pct
            },
            \"detail\": sex_detail,
            \"confidence_rating\": \"Medium\",
            \"supporting_text\": n_support,
            \"location\": location
        },
        \"age\": {
            \"answer\": {
                \"unit\": \"years\",
                \"min\": \"NR\",
                \"max\": \"NR\",
                \"mean\": \"NR\",
                \"sd\": \"NR\",
                \"note\": \"\"
            },
            \"detail\": \"Age not reported for these diagnostic groups in the case-control table.\",
            \"confidence_rating\": \"Low\",
            \"supporting_text\": \"\",
            \"location\": \"\"
        }
    }
    cohorts.append(cohort)

out={
    \"clinical_cohort_part\": {
        \"cc0_applicability\": {\"answer\": \"Yes\"},
        \"cc1_clinical_cohorts\": cohorts
    }
}

out_path=Path('DE_v14_Bethlehem2021_by_codex_20260303185331925.json')
with out_path.open('w', encoding='utf-8') as f:
    json.dump(out, f, ensure_ascii=False, indent=2)

print('written', out_path)
