import pandas as pd
path='study_1/Table3_CaseControl/Table_3_1_Grey_matter_volume_PermDx.csv'
df=pd.read_csv(path)
cn=df[df['Group 1']=='CN']
res=cn[['Group 2','Sex','Sample size G2']].drop_duplicates()
# pivot
pivot=res.pivot(index='Group 2', columns='Sex', values='Sample size G2')
for dx,row in pivot.iterrows():
    female=row.get('Female')
    male=row.get('Male')
    total=female+male
    female_pct=round(female/total*100,1)
    male_pct=round(male/total*100,1)
    print(dx, female, male, total, female_pct, male_pct)
