import csv
path='study_1/Table3_CaseControl/Table_3_1_Grey_matter_volume_PermDx.csv'
# read raw lines
with open(path, 'r', encoding='utf-8') as f:
    lines=f.read().splitlines()
print(lines[0])
# build mapping of group2+sex to line
lines_data=lines[1:]
map_line={}
for line in lines_data:
    parts=line.split(',')
    if len(parts)<13:
        continue
    group1, group2, sex = parts[0], parts[1], parts[12]
    if group1=='CN':
        map_line[(group2, sex)]=line
# print for desired groups
for group in ['AD','ADHD','Anxiety/Phobia','ASD','LMCI','MCI','MDD','SCZ']:
    for sex in ['Female','Male']:
        print(group, sex, map_line.get((group, sex)))
