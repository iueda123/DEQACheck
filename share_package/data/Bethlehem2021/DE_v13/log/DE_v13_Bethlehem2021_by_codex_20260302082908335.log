/bin/bash -lc "python - <<'PY'
import csv, math, os
base = 'study_1/Table1_Demographics'
files = [
    ('GMV', 'Table_1_2_Grey_matter_volume.csv'),
    ('WMV', 'Table_1_3_White_matter_volume.csv'),
    ('sGMV', 'Table_1_4_Subcortical_grey_matter_volume.csv'),
    ('Ventricular volume', 'Table_1_5_Ventricular_volume.csv'),
    ('Total cerebrum volume', 'Table_1_6_Total_cerebrum_volume.csv'),
    ('Mean cortical thickness', 'Table_1_7_Mean_cortical_thickness.csv'),
    ('Total surface area', 'Table_1_8_Total_surface_area.csv'),
]

def summarize(path):
    total = 0
    female = 0
    male = 0
    wsum = 0.0
    min_age = None
    max_age = None
    with open(path, newline='') as f:
        reader = csv.DictReader(f)
        for row in reader:
            n = int(row['Sample size'])
            sex = row['Sex'].strip()
            mean_age = float(row['Mean Age (in days)'])
            min_a = float(row['Minimum age (in days)'])
            max_a = float(row['Maximum age (in days)'])
            total += n
            if sex.lower().startswith('f'):
                female += n
            elif sex.lower().startswith('m'):
                male += n
            wsum += mean_age * n
            min_age = min_a if min_age is None else min(min_age, min_a)
            max_age = max_a if max_age is None else max(max_age, max_a)
    mean_age_days = wsum / total if total else float('nan')
    return {
        'total': total,
        'female': female,
        'male': male,
        'mean_age_days': mean_age_days,
        'min_age_days': min_age,
        'max_age_days': max_age,
    }

for label, fname in files:
    path = os.path.join(base, fname)
    s = summarize(path)
    print(label)
    print(s)
