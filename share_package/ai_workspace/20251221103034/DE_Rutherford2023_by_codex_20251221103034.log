    if not line.startswith('|'): continue
    parts=[p.strip() for p in line.strip().split('|')[1:-1]]
    if not parts: continue
    site=parts[0]
    if site in ('Train','N','Site'): continue
    if len(parts)<7: continue
    try:
        tn=float(parts[1]); ttest=float(parts[4])
    except: continue
    rows.append((tn,parts[2],parts[3],ttest,parts[5],parts[6]))
# helper

def sex_counts(sexstr,n):
    try:
        f,m=[float(x) for x in sexstr.split(',')]
        return n*f/100,n*m/100
    except:
        return 0,0

train_f=train_m=0
for tn,sex,age,ttn,sex2,age2 in rows:
    f,m=sex_counts(sex,tn); train_f+=f; train_m+=m
train_total=sum(r[0] for r in rows)
print('train N',train_total,'train female',train_f,'male',train_m,'female%',train_f/(train_f+train_m)*100)
all_f=all_m=0
for tn,sex,age,ttn,sex2,age2 in rows:
    f,m=sex_counts(sex,tn); all_f+=f; all_m+=m
    f,m=sex_counts(sex2,ttn); all_f+=f; all_m+=m
all_total=train_total+sum(r[3] for r in rows)
print('all total',all_total,'female%',all_f/(all_f+all_m)*100)

# age stats functions

def mean_and_sd(entries):
    # entries list of (n, mean, sd)
    tot_n=sum(n for n,_,_ in entries)
    weighted_mean=sum(n*m for n,m,_ in entries)/tot_n
    var_num=0
    for n,m,sd in entries:
        var_num += (n-1)*sd**2 + n*(m-weighted_mean)**2
    pooled_sd=(var_num/(tot_n-1))**0.5
    return weighted_mean, pooled_sd

train_entries=[]
all_entries=[]
for tn,sex,age,ttn,sex2,age2 in rows:
    try:
        m=float(age.split(',')[0]); sd=float(age.split(',')[1]); train_entries.append((tn,m,sd))
    except: pass
    try:
        m=float(age2.split(',')[0]); sd=float(age2.split(',')[1]); all_entries.append((ttn,m,sd))
    except: pass
    all_entries.append((tn,float(age.split(',')[0]),float(age.split(',')[1])))
